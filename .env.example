# ── classroom-frontend environment ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Every var must be prefixed with VITE_ to be exposed to the browser bundle.

# (required) Base URL of the backend API, including the /api suffix.
VITE_BACKEND_BASE_URL='http://localhost:8000/api'

# ── Cloudinary (unsigned + signed uploads from the browser) ───────────────────
# The API key is NOT a secret — Cloudinary's signed-upload flow needs it client-side.
# The API *secret* stays server-only in classroom-backend/.env.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# Optional: set to true only after the school has approved Site24x7 RUM and its
# privacy notice/cookie handling. It is disabled by default.
VITE_ENABLE_RUM=false
# Optional: the deployed public origin, used for canonical and social URLs.
VITE_PUBLIC_SITE_URL=
